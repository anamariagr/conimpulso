{
  "openapi": "3.0.3",
  "info": {
    "title": "NexusLab API",
    "description": "Marketplace API for B2B and B2C connections. Includes authentication, products, shops, B2B connections, leads, messaging, wallet, advertising, and AI features.",
    "version": "1.0.0",
    "contact": {
      "name": "NexusLab Support",
      "email": "api@nexuslab.com"
    }
  },
  "servers": [
    {
      "url": "http://localhost/api",
      "description": "Local development"
    },
    {
      "url": "https://api.nexuslab.com",
      "description": "Production"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {"type": "integer"},
          "name": {"type": "string"},
          "email": {"type": "string"},
          "avatar": {"type": "string", "nullable": true},
          "role": {"type": "string"},
          "created_at": {"type": "string", "format": "date-time"}
        }
      },
      "Shop": {
        "type": "object",
        "properties": {
          "id": {"type": "integer"},
          "name": {"type": "string"},
          "slug": {"type": "string"},
          "description": {"type": "string"},
          "city": {"type": "string"},
          "is_verified": {"type": "boolean"},
          "followers": {"type": "integer"},
          "views": {"type": "integer"}
        }
      },
      "Product": {
        "type": "object",
        "properties": {
          "id": {"type": "integer"},
          "name": {"type": "string"},
          "description": {"type": "string"},
          "price": {"type": "number"},
          "stock": {"type": "integer"},
          "sku": {"type": "string"},
          "status": {"type": "string"}
        }
      },
      "BusinessProfile": {
        "type": "object",
        "properties": {
          "id": {"type": "integer"},
          "company_name": {"type": "string"},
          "business_type": {"type": "string"},
          "nit": {"type": "string"},
          "verification_status": {"type": "string"}
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": {"type": "string"},
          "errors": {"type": "object"}
        }
      }
    }
  },
  "paths": {
    "/auth/register": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Register new user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "email", "password"],
                "properties": {
                  "name": {"type": "string"},
                  "email": {"type": "string", "format": "email"},
                  "password": {"type": "string", "minLength": 8}
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User registered successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {"$ref": "#/components/schemas/User"},
                    "token": {"type": "string"}
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/Error"}
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Login user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": {"type": "string", "format": "email"},
                  "password": {"type": "string"}
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Get current user profile",
        "security": [{"bearerAuth": []}],
        "responses": {
          "200": {
            "description": "Current user data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {"$ref": "#/components/schemas/User"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/products": {
      "get": {
        "tags": ["Products"],
        "summary": "List all products",
        "parameters": [
          {"name": "category", "in": "query", "schema": {"type": "integer"}},
          {"name": "search", "in": "query", "schema": {"type": "string"}},
          {"name": "page", "in": "query", "schema": {"type": "integer", "default": 1}},
          {"name": "limit", "in": "query", "schema": {"type": "integer", "default": 20}}
        ],
        "responses": {
          "200": {
            "description": "List of products"
          }
        }
      }
    },
    "/shops": {
      "get": {
        "tags": ["Shops"],
        "summary": "List all shops",
        "parameters": [
          {"name": "search", "in": "query", "schema": {"type": "string"}},
          {"name": "city", "in": "query", "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {
            "description": "List of shops"
          }
        }
      }
    },
    "/b2b/profiles": {
      "get": {
        "tags": ["B2B"],
        "summary": "List business profiles",
        "security": [{"bearerAuth": []}],
        "responses": {
          "200": {
            "description": "List of verified business profiles"
          }
        }
      }
    },
    "/leads": {
      "get": {
        "tags": ["Leads"],
        "summary": "List leads",
        "security": [{"bearerAuth": []}],
        "responses": {
          "200": {
            "description": "List of leads"
          }
        }
      },
      "post": {
        "tags": ["Leads"],
        "summary": "Create new lead",
        "security": [{"bearerAuth": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "email"],
                "properties": {
                  "name": {"type": "string"},
                  "email": {"type": "string", "format": "email"},
                  "phone": {"type": "string"},
                  "source": {"type": "string"}
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Lead created"
          }
        }
      }
    },
    "/wallet": {
      "get": {
        "tags": ["Wallet"],
        "summary": "Get user wallet",
        "security": [{"bearerAuth": []}],
        "responses": {
          "200": {
            "description": "Wallet data with balance"
          }
        }
      }
    },
    "/advertising/campaigns": {
      "get": {
        "tags": ["Advertising"],
        "summary": "List advertising campaigns",
        "security": [{"bearerAuth": []}],
        "responses": {
          "200": {
            "description": "List of campaigns"
          }
        }
      },
      "post": {
        "tags": ["Advertising"],
        "summary": "Create campaign",
        "security": [{"bearerAuth": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "budget"],
                "properties": {
                  "name": {"type": "string"},
                  "budget": {"type": "number"},
                  "daily_budget": {"type": "number"},
                  "start_date": {"type": "string", "format": "date"},
                  "end_date": {"type": "string", "format": "date"}
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Campaign created"
          }
        }
      }
    },
    "/ai/recommendations/trending": {
      "get": {
        "tags": ["AI"],
        "summary": "Get trending products",
        "responses": {
          "200": {
            "description": "Trending products list"
          }
        }
      }
    },
    "/ai/categories/suggest": {
      "get": {
        "tags": ["AI"],
        "summary": "Suggest categories for product",
        "parameters": [
          {"name": "name", "in": "query", "required": true, "schema": {"type": "string"}},
          {"name": "description", "in": "query", "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {
            "description": "Category suggestions with confidence scores"
          }
        }
      }
    }
  }
}