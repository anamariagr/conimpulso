{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.conimpulso.com/api/:path*"
    },
    {
      "source": "/storage/:path*",
      "destination": "https://api.conimpulso.com/storage/:path*"
    },
    {
      "source": "/((?!api/|storage/).*)",
      "destination": "/index.html"
    }
  ]
}
